# Copy to .env for local development. .env is git-ignored; never commit secrets.
DATABASE_URL=postgres://ananda:ananda@localhost:5434/ananda_agents
PORT=4020
WEB_ORIGIN=http://localhost:3020

# 32 random bytes, base64, for IBAN and contact-data encryption: openssl rand -base64 32
# Required in production. Changing it makes stored IBANs and contacts unreadable.
DATA_KEY=

# Mailpit from docker-compose (inbox at http://localhost:8027)
SMTP_HOST=localhost
SMTP_PORT=1027
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ANANDA <sales@ananda.test>"

# EU VIES. Set VIES_OFFLINE=true to test the "register unavailable" path.
VIES_OFFLINE=false

# Seller details printed on proformas (placeholders until ANANDA confirms them)
SELLER_NAME="ANANDA Ltd. (demo details)"
SELLER_ADDRESS="Sofia, Bulgaria"
SELLER_VAT=BG000000000
SELLER_IBAN="BG00 XXXX 0000 0000 0000 00"
SELLER_BANK="Bank (set SELLER_BANK)"
SELLER_EMAIL=office@ananda.test
